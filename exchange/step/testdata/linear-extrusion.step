ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Independently authored parabolic curtain'),'2;1');
FILE_NAME('curtain.step','',(''),(''),'','', '');
FILE_SCHEMA(('CONFIG_CONTROL_DESIGN'));
ENDSEC;
DATA;
#1=B_SPLINE_CURVE_WITH_KNOTS('arch',2,(#2,#3,#4),.UNSPECIFIED.,.F.,.F.,(3,3),(0.,1.),.UNSPECIFIED.);
#2=CARTESIAN_POINT('',(0.,0.,0.));
#3=CARTESIAN_POINT('',(1.,2.,0.));
#4=CARTESIAN_POINT('',(2.,0.,0.));
#5=DIRECTION('',(0.,0.,1.));
#6=VECTOR('',#5,1.);
#7=SURFACE_OF_LINEAR_EXTRUSION('',#1,#6);
#8=RECTANGULAR_TRIMMED_SURFACE('curtain',#7,0.,1.,-1.,2.,.T.,.T.);
#9=GEOMETRIC_SET('',(#8));
#10=GEOMETRICALLY_BOUNDED_SURFACE_SHAPE_REPRESENTATION('',(#9),#11);
#11=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNIT_ASSIGNED_CONTEXT((#12,#13,#14)) REPRESENTATION_CONTEXT('',''));
#12=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#13=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#14=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
ENDSEC;
END-ISO-10303-21;
