ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('independent composite'),'2;1');
FILE_NAME('','',(''),(''),'OCCT fixture','','');
FILE_SCHEMA(('CONFIG_CONTROL_DESIGN'));
ENDSEC;
DATA;
#1 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#2 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#3 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#4 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNIT_ASSIGNED_CONTEXT(
(#1,#2,#3)) REPRESENTATION_CONTEXT('','') );
#5 = CARTESIAN_POINT('',(0.,0.,0.));
#6 = CARTESIAN_POINT('',(1.,0.,0.));
#7 = B_SPLINE_CURVE_WITH_KNOTS('line',1,(#5,#6),.UNSPECIFIED.,.F.,.U.,(2
    ,2),(0.,1.),.UNSPECIFIED.);
#8 = CARTESIAN_POINT('',(2.,1.,0.));
#9 = CARTESIAN_POINT('',(2.,0.,0.));
#10 = CARTESIAN_POINT('',(1.,0.,0.));
#11 = ( BOUNDED_CURVE() B_SPLINE_CURVE(2,(#8,#9,#10),.UNSPECIFIED.,.F.,
.U.) B_SPLINE_CURVE_WITH_KNOTS((3,3),(0.,1.),.UNSPECIFIED.) CURVE()
GEOMETRIC_REPRESENTATION_ITEM() RATIONAL_B_SPLINE_CURVE((1.,0.75,1.))
REPRESENTATION_ITEM('reversed rational bend') );
#12 = COMPOSITE_CURVE_SEGMENT(.CONTINUOUS.,.T.,#7);
#13 = COMPOSITE_CURVE_SEGMENT(.DISCONTINUOUS.,.F.,#11);
#14 = COMPOSITE_CURVE('composite',(#12,#13),.U.);
#15 = GEOMETRIC_CURVE_SET('ordered set',(#14));
#16 = GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION(
  'wire geometry',(#15),#4);
#17 = APPLICATION_CONTEXT(
'configuration controlled 3d designs of mechanical parts and assemblies'
  );
#18 = APPLICATION_PROTOCOL_DEFINITION('international standard',
  'config_control_design',1994,#17);
#19 = MECHANICAL_CONTEXT('',#17,'mechanical');
#20 = DESIGN_CONTEXT('',#17,'design');
#21 = PRODUCT('1','composite product','',(#19));
#22 = PRODUCT_DEFINITION_FORMATION_WITH_SPECIFIED_SOURCE('','',#21,
  .NOT_KNOWN.);
#23 = PRODUCT_DEFINITION('design','',#22,#20);
#24 = PRODUCT_DEFINITION_SHAPE('','',#23);
#25 = SHAPE_DEFINITION_REPRESENTATION(#24,#16);
ENDSEC;
END-ISO-10303-21;
