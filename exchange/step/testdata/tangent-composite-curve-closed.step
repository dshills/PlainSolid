ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('independent composite'),'2;1');
FILE_NAME('','',(''),(''),'OCCT fixture','','');
FILE_SCHEMA(('CONFIG_CONTROL_DESIGN'));
ENDSEC;
DATA;
#1 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#2 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#3 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#4 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNIT_ASSIGNED_CONTEXT(
(#1,#2,#3)) REPRESENTATION_CONTEXT('','') );
#5 = CARTESIAN_POINT('',(0.,0.,0.));
#6 = CARTESIAN_POINT('',(1.5,0.,0.));
#7 = B_SPLINE_CURVE_WITH_KNOTS('line',1,(#5,#6),.UNSPECIFIED.,.F.,.U.,(2
    ,2),(0.,1.),.UNSPECIFIED.);
#8 = CARTESIAN_POINT('',(2.5,1.,0.));
#9 = CARTESIAN_POINT('',(2.5,0.,0.));
#10 = CARTESIAN_POINT('',(1.5,0.,0.));
#11 = ( BOUNDED_CURVE() B_SPLINE_CURVE(2,(#8,#9,#10),.UNSPECIFIED.,.F.,
.U.) B_SPLINE_CURVE_WITH_KNOTS((3,3),(0.,1.),.UNSPECIFIED.) CURVE()
GEOMETRIC_REPRESENTATION_ITEM() RATIONAL_B_SPLINE_CURVE((1.,0.75,1.))
REPRESENTATION_ITEM('reversed rational bend') );
#12 = COMPOSITE_CURVE_SEGMENT(.CONT_SAME_GRADIENT.,.T.,#7);
#13 = COMPOSITE_CURVE_SEGMENT(.CONTINUOUS.,.F.,#11);
#14 = CARTESIAN_POINT('',(2.5,1.,0.));
#15 = CARTESIAN_POINT('',(0.,0.,0.));
#16 = B_SPLINE_CURVE_WITH_KNOTS('return',1,(#14,#15),.UNSPECIFIED.,.F.,
  .U.,(2,2),(0.,1.),.UNSPECIFIED.);
#17 = COMPOSITE_CURVE_SEGMENT(.CONTINUOUS.,.T.,#16);
#18 = COMPOSITE_CURVE('composite',(#12,#13,#17),.U.);
#19 = GEOMETRIC_CURVE_SET('ordered set',(#18));
#20 = GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION(
  'wire geometry',(#19),#4);
#21 = APPLICATION_CONTEXT(
'configuration controlled 3d designs of mechanical parts and assemblies'
  );
#22 = APPLICATION_PROTOCOL_DEFINITION('international standard',
  'config_control_design',1994,#21);
#23 = MECHANICAL_CONTEXT('',#21,'mechanical');
#24 = DESIGN_CONTEXT('',#21,'design');
#25 = PRODUCT('1','composite product','',(#23));
#26 = PRODUCT_DEFINITION_FORMATION_WITH_SPECIFIED_SOURCE('','',#25,
  .NOT_KNOWN.);
#27 = PRODUCT_DEFINITION('design','',#26,#24);
#28 = PRODUCT_DEFINITION_SHAPE('','',#27);
#29 = SHAPE_DEFINITION_REPRESENTATION(#28,#20);
ENDSEC;
END-ISO-10303-21;
