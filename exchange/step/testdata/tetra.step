#32=POLY_LOOP('',(#102,#103,#100));
#40=FACE('',(#41));
#41=FACE_OUTER_BOUND('',#42,.T.);
#42=POLY_LOOP('',(#101,#102,#103));
#90=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNIT_ASSIGNED_CONTEXT((#91)) REPRESENTATION_CONTEXT('',''));
#91=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
