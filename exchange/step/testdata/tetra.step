DATA;
/* Authored from four coordinate points and outward triangle order. */
#1=FACETED_BREP_SHAPE_REPRESENTATION('tetra',(#2),#90);
#2=FACETED_BREP('tetra''s',#3);
#3=CLOSED_SHELL('',(#10,#20,#30,#40));
